{
  "enabled": true,
  "name": "API Postman Testing",
  "description": "Monitors API source code changes and automatically runs Postman collection tests to validate functionality",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "server/**/*.js",
      "server/**/*.ts",
      "server/routes/*.js",
      "server/controllers/*.js",
      "server/models/*.js",
      "package.json"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "API source code has been modified. Please check if .postman.json exists. If it doesn't exist or is empty, create a Postman collection for the NCTU ERP API. If it exists, get the collection ID and run the collection, showing me the results and propose fixes for any errors found."
  }
}